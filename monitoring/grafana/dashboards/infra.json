{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "tags": ["pipeline", "infra"],
  "timezone": "utc",
  "title": "Infra — Kafka / API / Процессы",
  "uid": "infra",
  "version": 1,
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "description": "Drill-down «на чём стоит»: топики и лаг по партициям, HTTP api, здоровье процессов консьюмеров (рестарты видны как обрыв uptime).",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Kafka: размеры топиков (живых сообщений)",
      "description": "current_offset − oldest_offset: сколько реально хранится с учётом retention (raw_frames = 1 час).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (topic) (kafka_topic_partition_current_offset - kafka_topic_partition_oldest_offset)", "legendFormat": "{{topic}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Kafka: лаг по группам",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (consumergroup) (kafka_consumergroup_lag{consumergroup=~\"yolo-workers|detection-writer|video-workers\"})", "legendFormat": "{{consumergroup}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Kafka: лаг yolo-workers по партициям raw_frames",
      "description": "Перекос по партициям = кадры «залипают» на одной партиции, пока другие реплики простаивают.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "kafka_consumergroup_lag{consumergroup=\"yolo-workers\", topic=\"raw_frames\"}", "legendFormat": "partition {{partition}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "API: RPS по маршрутам",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (handler) (rate(http_requests_total[5m]))", "legendFormat": "{{handler}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "API: не-2xx по статусам",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate(http_requests_total{status!~\"2..\"}[5m]))", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "API: p95 по маршрутам",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{handler}}" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Uptime процессов консьюмеров",
      "description": "Обрыв линии до нуля = рестарт. Периодические пилы = CUDA-цикл «упал↔поднялся» (restart-политика маскирует его от глаз).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "time() - process_start_time_seconds{job=~\".*-consumer\"}", "legendFormat": "{{job}} {{instance}}" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Память (RSS) и CPU процессов",
      "description": "Монотонный рост RSS у консьюмера = утечка (например, MinIO-буферы). CPU = rate(CPU-секунд) = ЧИСЛО ЯДЕР: 4 = четыре ядра параллельно (FFmpeg-декод многопоточен по умолчанию), поэтому больше 1 это норма.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "/CPU/" }, "properties": [ { "id": "unit", "value": "short" }, { "id": "custom.axisLabel", "value": "cores" }, { "id": "custom.axisPlacement", "value": "right" } ] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "process_resident_memory_bytes", "legendFormat": "RSS {{job}}" },
        { "refId": "B", "expr": "rate(process_cpu_seconds_total[5m])", "legendFormat": "CPU {{job}}" }
      ]
    }
  ]
}
