# ============================================================
# Единый образ платформы: api, dashboard, detection-consumer,
# stream-manager, video-consumer, yolo-consumer.
#
# torch/ultralytics в образе нет вовсе: инференс живёт в отдельном
# Triton-сервере (TensorRT engine), консьюмерам нужен только лёгкий
# gRPC-клиент (extra triton). Так ВСЕ сервисы занимают ~2 GB вместо
# 10.6 GB у CUDA-образа, а пересборка занимает минуты, а не час.
# ============================================================
FROM python:3.12-slim AS builder

WORKDIR /app

# Кэш слоя: копируем ТОЛЬКО манифест зависимостей + заглушку пакета.
# Пока manifest не меняется — слой с зависимостями не пересобирается.
# Extra dash — дашборд живёт в этом же образе.
COPY pyproject.toml ./
COPY app/__init__.py app/
RUN pip install --no-cache-dir ".[dash,triton]"

FROM python:3.12-slim

WORKDIR /app

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY . .

RUN mkdir -p uploads

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
