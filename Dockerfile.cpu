# ============================================================
# CPU-образ: api, detection-consumer, stream-manager, dashboard.
#
# Отличие от Dockerfile: без torch/ultralytics (extra gpu) — инференс
# нужен только video-consumer и yolo-consumer, они собираются из
# Dockerfile (CUDA). Так 4 из 6 сервисов занимают ~2 GB вместо 10.6 GB
# каждый, а их пересборка занимает минуты, а не час.
# ============================================================
FROM python:3.12-slim AS builder

WORKDIR /app

# Кэш слоя: манифест зависимостей + заглушка пакета (см. Dockerfile).
# Extra dash — дашборд живёт в этом образе; gpu сюда НЕ попадает.
COPY pyproject.toml ./
COPY app/__init__.py app/
RUN pip install --no-cache-dir ".[dash]"

FROM python:3.12-slim

WORKDIR /app

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY . .

RUN mkdir -p uploads

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
