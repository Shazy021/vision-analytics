name: "dali_letterbox"
backend: "dali"
max_batch_size: 16

input [
  {
    name: "DALI_INPUT_0"
    data_type: TYPE_UINT8
    dims: [ -1 ]
  }
]

output [
  {
    name: "DALI_OUTPUT_0"
    data_type: TYPE_UINT8
    dims: [ 3, 640, 640 ]
  }
]

instance_group [
  {
    # Замер 2026-11-12 (experiments/framepath.py): 3 инстанса НЕ дают прироста
    # (434 против 445 req/s) — очередь переезжает в движок, батч DALI
    # дробится (9.8 -> 7.7). Потолок ~445 req/s задан пропускной способностью
    # GPU (nvJPEG + SM + движок), а не числом инстансов.
    count: 2
    kind: KIND_GPU
  }
]

dynamic_batching {
  preferred_batch_size: [ 8 ]
  max_queue_delay_microseconds: 5000
}
