name: "yolo_jpeg"
platform: "ensemble"
max_batch_size: 16

input [
  {
    name: "jpeg"
    data_type: TYPE_UINT8
    dims: [ -1 ]
  }
]

output [
  {
    name: "num_detections"
    data_type: TYPE_INT32
    dims: [ 1 ]
  },
  {
    name: "boxes"
    data_type: TYPE_FP32
    dims: [ 300, 4 ]
  },
  {
    name: "scores"
    data_type: TYPE_FP32
    dims: [ 300 ]
  },
  {
    name: "classes"
    data_type: TYPE_INT32
    dims: [ 300 ]
  }
]

ensemble_scheduling {
  step [
    {
      model_name: "dali_letterbox"
      model_version: -1
      input_map { key: "DALI_INPUT_0" value: "jpeg" }
      output_map { key: "DALI_OUTPUT_0" value: "preprocessed" }
    },
    {
      model_name: "yolo_detector"
      model_version: -1
      input_map { key: "images" value: "preprocessed" }
      output_map { key: "num_detections" value: "num_detections" }
      output_map { key: "boxes" value: "boxes" }
      output_map { key: "scores" value: "scores" }
      output_map { key: "classes" value: "classes" }
    }
  ]
}
