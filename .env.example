# ============================================================
# Vision Analytics Platform — шаблон окружения.
#
# Скопируй в .env:  cp .env.example .env
#
# Значения ниже соответствуют запуску через docker-compose
# (хосты = имена сервисов: db, kafka, minio).
# compose подхватит их автоматически.
#
# ⚠️ ВАЖНО: этот .env ОБЩИЙ — docker compose читает его для подстановки
# ${VAR} в docker-compose.yml. Если заменить хосты на localhost и запустить
# стек через compose, контейнеры получат недоступные адреса: localhost
# внутри контейнера — это сам контейнер, а не твоя машина.
#
# Локальный запуск БЕЗ Docker (alembic, скрипты с хостовой машины) — создай
# рядом файл .env.local (в .gitignore): он перечитывается ПОСЛЕ .env и
# переопределяет его. Хосты бери с проброшенными портами:
#   DATABASE_URL=postgresql://user:pass@localhost:5432/vision
#   KAFKA_BOOTSTRAP_SERVERS=localhost:9092
#   S3_ENDPOINT=http://localhost:9000
# Docker-стек .env.local не видит (контейнеры читают переменные из compose).
# (тестам это не нужно — они герметичны и не ходят в сеть)
# ============================================================

# --- База данных (PostgreSQL) ---
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=vision
# Для локального запуска: postgresql://user:pass@localhost:5432/vision
DATABASE_URL=postgresql://user:pass@db:5432/vision

# --- Kafka ---
# Для локального запуска: localhost:9092
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# --- S3 / MinIO ---
# Для локального запуска: http://localhost:9000
S3_ENDPOINT=http://minio:9000
# Адрес MinIO для presigned URL, которые открывает БРАУЗЕР (видео-плеер в
# дашборде). Браузер не резолвит docker-имена (minio:9000), поэтому ссылка
# должна быть по адресу с проброшенным портом. Обычно http://localhost:9000.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=vision

# --- Детекция (инференс — только Triton Inference Server) ---
# Модель (TensorRT engine) живёт в сервисе triton: GPU + собранный engine
# (models/triton/yolo_detector/1/model.plan, сборка — внешняя репа yolo-trt-nms)
# обязательны для работы детекций. Консьюмерам нужен только gRPC-клиент.
# В docker-сети TRITON_URL = triton:8001; для запуска консьюмера с хоста —
# localhost:18001 (standalone-контейнер Triton).
TRITON_URL=triton:8001
TRITON_MODEL_NAME=yolo_detector
# JPEG-intake (стримовый путь): yolo-consumer шлёт JPEG-байты в DALI-ансамбль
# yolo_jpeg (декод/resize/letterbox на GPU Triton'а) вместо клиентского
# imdecode+letterbox. Требует модели yolo_jpeg + dali_letterbox в models/triton.
# Видео-трасса (processor.py) флаг не читает — она остаётся на yolo_detector.
# TRITON_JPEG_INTAKE=false
# TRITON_JPEG_MODEL_NAME=yolo_jpeg
EXTRACT_FPS=5
MAX_FRAMES=0
# Чанкование длинных видео: размер чанка (с) и порог, с которого видео
# начинают резать (с). Короткие ролики обрабатываются одним проходом.
VIDEO_CHUNK_SEC=30
VIDEO_MIN_CHUNK_DURATION=45
# Пропускная способность yolo-consumer (raw_frames): стримовый инференс —
# поток одиночных async-запросов в Triton (батчи склеивает сервер).
# YOLO_INFER_WINDOW — сколько кадров держать «в полёте» к Triton (меньше —
# GPU голодает в сетевых паузах, больше — латентность и RAM; замер: 32–64).
# TRITON_CHANNELS — независимые gRPC-каналы клиента (= потоки отправки,
# один канал ~110 req/s потолок). YOLO_IO_WORKERS — потоки декода: при
# упоре в декод поднимать до 8.
# YOLO_INFER_WINDOW=64
# TRITON_CHANNELS=4
# YOLO_IO_WORKERS=4
# Пропускная способность detection-consumer (detections → БД): число
# сообщений в одной транзакции (bulk INSERT вместо построчного commit)
# и окно ожидания ПЕРВОГО сообщения батча (мс). Сборка динамическая:
# батч расширяется, только пока очередь горячая.
# DETECTION_BATCH_SIZE=256
# DETECTION_BATCH_GRACE_MS=50

# --- Трекинг стримов (ByteTrack в detection-consumer) ---
# Дефолты из app/core/config.py подходят; пороги и таймауты объяснены там же.
# TRACKING_ENABLED=true
# TRACK_HIGH_THRESH=0.5
# TRACK_LOW_THRESH=0.25
# TRACK_MAX_AGE_SEC=3.0
# TRACK_MIN_HITS=2
# TRACK_DEFAULT_DT_SEC=0.2
# TRACK_IDLE_EVICT_SEC=300

# --- Дашборд (Streamlit) ---
API_URL=http://api:8000

# --- Observability (Prometheus + Grafana) ---
# Консьюмеры отдают /metrics на дефолтных портах: yolo-consumer=9091,
# detection-consumer=9092, video-consumer=9093; api — на своём 8000
# (prometheus-fastapi-instrumentator). METRICS_PORT переопределяет порт
# консьюмера — в docker-сте НЕ задавай: scrape-таргеты в
# monitoring/prometheus/prometheus.yml зафиксированы на дефолтах.
# UI: Prometheus http://localhost:9090, Grafana http://localhost:3000
# (анонимный Viewer), kafka-exporter http://localhost:9308/metrics.
# METRICS_PORT=9091
