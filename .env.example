# ============================================================
# Vision Analytics Platform — шаблон окружения.
#
# Скопируй в .env:  cp .env.example .env
#
# Значения ниже соответствуют запуску через docker-compose
# (хосты = имена сервисов: db, redis, kafka, minio).
# compose подхватит их автоматически.
#
# ⚠️ ВАЖНО: этот .env ОБЩИЙ — docker compose читает его для подстановки
# ${VAR} в docker-compose.yml. Если заменить хосты на localhost и запустить
# стек через compose, контейнеры получат недоступные адреса: localhost
# внутри контейнера — это сам контейнер, а не твоя машина.
#
# Локальный запуск БЕЗ Docker (alembic, скрипты с хостовой машины) — создай
# рядом файл .env.local (в .gitignore): он перечитывается ПОСЛЕ .env и
# переопределяет его. Хосты бери с проброшенными портами:
#   DATABASE_URL=postgresql://user:pass@localhost:5432/vision
#   KAFKA_BOOTSTRAP_SERVERS=localhost:9092
#   S3_ENDPOINT=http://localhost:9000
# Docker-стек .env.local не видит (контейнеры читают переменные из compose).
# (тестам это не нужно — они герметичны и не ходят в сеть)
# ============================================================

# --- База данных (PostgreSQL) ---
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=vision
# Для локального запуска: postgresql://user:pass@localhost:5432/vision
DATABASE_URL=postgresql://user:pass@db:5432/vision

# --- Celery (Redis) ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Kafka ---
# Для локального запуска: localhost:9092
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# --- S3 / MinIO ---
# Для локального запуска: http://localhost:9000
S3_ENDPOINT=http://minio:9000
# Адрес MinIO для presigned URL, которые открывает БРАУЗЕР (видео-плеер в
# дашборде). Браузер не резолвит docker-имена (minio:9000), поэтому ссылка
# должна быть по адресу с проброшенным портом. Обычно http://localhost:9000.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=vision

# --- YOLO ---
WEIGHTS_PATH=app/detection/models/yolov8n.pt
EXTRACT_FPS=5
MAX_FRAMES=0
# auto = cuda при наличии GPU, иначе cpu — проект заводится на любой машине.
# Варианты: auto / cpu / cuda / 0 / 1
DEVICE=auto

# --- Дашборд (Streamlit) ---
API_URL=http://api:8000
